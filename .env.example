# =====================================================================
# NEXDrive — environment template.
# Copy to .env (local) or enter in your host's secret manager (production).
# NEVER commit .env. NEVER put any of these values in js/config.js (it is public).
# [R] = required in production   [O] = optional   [L] = local development only
# Full descriptions: CONFIGURATION_CHECKLIST.md
# =====================================================================

# ---------- Application ----------
# [R] production | development
NODE_ENV=production
# [R] API listen port
PORT=8080
# [R] Front-end URL (links in e-mails, CORS default)
APP_URL=https://app.nexdrive.co.uk
# [R] Public API base URL
API_BASE_URL=https://api.nexdrive.co.uk/v1
# [R] Comma-separated allow-list, no wildcards
CORS_ORIGINS=https://app.nexdrive.co.uk
# [R]
TZ=Europe/London

# ---------- Database (PostgreSQL 15+) ----------
# [R]
DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
# [R] require in production; disable only locally
DATABASE_SSL=require
# [O]
DATABASE_POOL_MAX=10

# ---------- Local docker-compose database ----------
# [L]
POSTGRES_USER=nexdrive
# [L] choose your own local value
POSTGRES_PASSWORD=
# [L]
POSTGRES_DB=nexdrive

# ---------- Queue / cache ----------
# [R] background jobs (reminders, messages, referrals)
REDIS_URL=rediss://<REDIS_HOST>:6379

# ---------- Authentication ----------
# [R] openssl rand -base64 64
JWT_ACCESS_SECRET=
# [O]
JWT_ACCESS_TTL=15m
# [O]
REFRESH_TOKEN_TTL=30d
# [R] openssl rand -base64 32 (licence + bank fields)
FIELD_ENCRYPTION_KEY=
# [O] only during key rotation
FIELD_ENCRYPTION_KEY_PREVIOUS=
# [O] argon2id memory cost
PASSWORD_HASH_MEMORY_KIB=19456

# ---------- Payments (Stripe) ----------
# [R] sk_live_...
STRIPE_SECRET_KEY=
# [R] whsec_...
STRIPE_WEBHOOK_SECRET=
# [R] price_... (Monthly)
STRIPE_PRICE_1M=
# [R] price_... (12 months)
STRIPE_PRICE_12M=
# [R] price_... (24 months)
STRIPE_PRICE_24M=
# [R] price_... (36 months)
STRIPE_PRICE_36M=
# [O]
TRIAL_DAYS=14

# ---------- SMS / WhatsApp (Twilio) ----------
# [R]
TWILIO_ACCOUNT_SID=
# [R]
TWILIO_AUTH_TOKEN=
# [R] MG...
TWILIO_MESSAGING_SERVICE_SID=
# [O] whatsapp:+44...
TWILIO_WHATSAPP_FROM=
# [O]
FEATURE_WHATSAPP=false

# ---------- E-mail (Postmark or Amazon SES) ----------
# [R]
EMAIL_PROVIDER_API_KEY=
# [R] use a verified sender domain
EMAIL_FROM="NexDrive <no-reply@example.co.uk>"

# ---------- File storage (S3-compatible, private bucket) ----------
# [R] profile photos
STORAGE_BUCKET=
# [R]
STORAGE_REGION=eu-west-2
# [O] only for non-AWS S3 providers
STORAGE_ENDPOINT=
# [O] prefer an IAM role
STORAGE_ACCESS_KEY_ID=
# [O] prefer an IAM role
STORAGE_SECRET_ACCESS_KEY=

# ---------- Push notifications ----------
# [R if push reminders are enabled]
PUSH_EXPO_ACCESS_TOKEN=

# ---------- Referral programme ----------
# [R] must equal referralBaseUrl in js/config.js
REFERRAL_BASE_URL=https://app.nexdrive.co.uk/join
# [O]
REFERRAL_REWARD_PERCENT=20
# [O]
REFERRAL_FREE_MONTHS=1
# [O]
REFERRAL_HOLD_DAYS=14
# [O]
REFERRAL_VALIDATE_RATE_LIMIT=10

# ---------- Operations ----------
# [O]
SENTRY_DSN=
# [O]
LOG_LEVEL=info
# [O]
RATE_LIMIT_PER_MIN=100
# [O]
REMINDER_DEFAULT_MINUTES=30

# ---------- Front-end build values (used only with config/config.template.js) ----------
# [R] demo | live
NEXDRIVE_MODE=demo
# [R when live]
NEXDRIVE_API_BASE_URL=https://api.nexdrive.co.uk/v1
# [R]
NEXDRIVE_REFERRAL_BASE_URL=https://app.nexdrive.co.uk/join
# [R] false for real users
NEXDRIVE_SHOW_DEMO_PANEL=false
# [O]
NEXDRIVE_DEVICE_FRAME=true
