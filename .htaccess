# NEXDrive — Apache / cPanel / LiteSpeed configuration for the static front end.
# Upload this file to the folder that contains index.html (it is a hidden file:
# turn on "Show hidden files" in cPanel File Manager). Requires mod_headers, mod_rewrite,
# mod_expires and mod_deflate (all standard on cPanel). Nginx users: see server/nginx.conf.example.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2

# ---------- HTTPS + canonical host ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Never serve developer-only files or folders
  RewriteRule ^(database|server|config|docs)(/|$) - [F,L]
  RewriteRule (^|/)\. - [F,L]
  RewriteRule \.(md|sql|example|yml|yaml|json)$ - [F,L]
</IfModule>

<FilesMatch "^\.|\.(md|sql|example|yml|yaml)$">
  Require all denied
</FilesMatch>

# ---------- Security headers (app) ----------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header always set X-Robots-Tag "noindex, nofollow"
  # The app's UI runtime needs 'unsafe-eval'. Replace api.nexdrive.co.uk with your API_BASE_URL host.
  # frame-ancestors lets the product page (and the Nexyra site) show the live demo.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.nexdrive.co.uk; frame-ancestors 'self' https://nexyraconsulting.co.uk; base-uri 'self'; form-action 'self'"

  # Caching: HTML, config and manifest always revalidate; fonts and vendor scripts are immutable.
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <Files "config.js">
    Header set Cache-Control "no-cache"
  </Files>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
