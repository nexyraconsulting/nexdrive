{
  "name": "NexDrive design tokens",
  "version": "1.0.0",
  "font": {
    "family": "Hanken Grotesk",
    "fallback": [
      "Helvetica Neue",
      "Arial",
      "sans-serif"
    ],
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "color": {
    "brand": {
      "violet50": "#F7F5FF",
      "violet100": "#EDE9FE",
      "violet400": "#A78BFA",
      "violet500": "#8B5CF6",
      "violet": "#7C3AED",
      "violet700": "#6D28D9",
      "violet800": "#5B21B6",
      "slice": "#9333EA",
      "blue": "#3B82F6"
    },
    "gradient": {
      "stops": [
        [
          "#A78BFA",
          0
        ],
        [
          "#7C3AED",
          0.39
        ],
        [
          "#3B82F6",
          1
        ]
      ],
      "angle": 90
    },
    "neutral": {
      "ink": "#0A0A0F",
      "ink2": "#1A1A24",
      "slate": "#4A4A5A",
      "muted": "#6B6B7B",
      "subtle": "#9A9AAA",
      "border": "#CFCFD8",
      "line": "#E7E7EC",
      "mist": "#F7F7F9",
      "white": "#FFFFFF"
    },
    "status": {
      "ongoing": {
        "bar": "#7C3AED",
        "badgeBg": "#7C3AED",
        "badgeFg": "#FFFFFF",
        "tint": "#EDE9FE",
        "ink": "#5B21B6"
      },
      "upcoming": {
        "bar": "#2563EB",
        "badgeBg": "#DBEAFE",
        "badgeFg": "#1D4ED8",
        "tint": "#EFF6FF",
        "ink": "#1E3A8A"
      },
      "completed": {
        "bar": "#16A34A",
        "badgeBg": "#DCFCE7",
        "badgeFg": "#166534",
        "tint": "#F0FDF4",
        "ink": "#14532D"
      },
      "cancelled": {
        "bar": "#DC2626",
        "badgeBg": "#FEE2E2",
        "badgeFg": "#991B1B",
        "tint": "#FEF2F2",
        "ink": "#7F1D1D"
      },
      "rescheduled": {
        "bar": "#D97706",
        "badgeBg": "#FEF3C7",
        "badgeFg": "#92400E",
        "tint": "#FFFBEB",
        "ink": "#78350F"
      }
    },
    "feedback": {
      "error": {
        "fg": "#B91C1C",
        "fgStrong": "#991B1B",
        "bg": "#FEF2F2",
        "border": "#FECACA"
      },
      "warning": {
        "fg": "#92400E",
        "fgStrong": "#78350F",
        "bg": "#FFFBEB",
        "border": "#FDE68A",
        "accent": "#D97706"
      },
      "success": {
        "fg": "#166534",
        "bg": "#DCFCE7",
        "bgSoft": "#F0FDF4",
        "border": "#BBF7D0"
      }
    },
    "badge": {
      "adi": "#16A34A",
      "pdi": "#EC4899"
    }
  },
  "type": {
    "display": {
      "size": 40,
      "weight": 600,
      "tracking": -0.03,
      "lineHeight": 1.02
    },
    "screenTitle": {
      "size": 28,
      "weight": 600,
      "tracking": -0.025,
      "lineHeight": 1.1
    },
    "sheetTitle": {
      "size": 20,
      "weight": 600,
      "tracking": -0.015
    },
    "listPrimary": {
      "size": 16,
      "weight": 600
    },
    "body": {
      "size": 15,
      "weight": 400,
      "lineHeight": 1.55
    },
    "meta": {
      "size": 13,
      "weight": 400
    },
    "label": {
      "size": 11,
      "weight": 600,
      "tracking": 0.16,
      "transform": "uppercase"
    },
    "numeral": {
      "weight": 700,
      "features": [
        "tnum"
      ]
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "screenGutter": 20,
    "sectionGap": 22
  },
  "size": {
    "touchMin": 44,
    "buttonPrimary": 52,
    "buttonHero": 54,
    "input": 52,
    "navBar": 60,
    "fab": 52,
    "avatarList": 44,
    "avatarProfile": 64
  },
  "radius": {
    "all": 0
  },
  "border": {
    "rule": "2px solid #0A0A0F",
    "hairline": "1px solid #E7E7EC",
    "input": "1.5px solid #CFCFD8",
    "inputFocus": "1.5px solid #7C3AED",
    "inputError": "1.5px solid #B91C1C"
  },
  "motion": {
    "sheet": "260ms cubic-bezier(.2,.8,.2,1)",
    "toast": "220ms ease-out",
    "fade": "180ms ease-out",
    "launch": "~2.7s then 400ms fade"
  },
  "icon": {
    "set": "Lucide",
    "stroke": 1.75,
    "sizes": [
      16,
      20,
      24
    ]
  }
}
