{
  "name": "nexdrive",
  "version": "1.0.0",
  "private": true,
  "description": "NexDrive — installable PWA (lessons, learners, bookings for UK driving instructors). Node.js/Express server for GoDaddy Node.js Hosting.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "build": "node build.js",
    "prestart": "node build.js",
    "start": "node server.js",
    "dev": "node build.js && node --watch server.js",
    "clean": "node -e \"require('fs').rmSync('public/sw-precache.js',{force:true})\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
