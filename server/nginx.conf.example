# NexDrive static front end — example Nginx server block.
server {
  listen 443 ssl http2;
  server_name app.nexdrive.co.uk;
  # ssl_certificate     /etc/letsencrypt/live/app.nexdrive.co.uk/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/app.nexdrive.co.uk/privkey.pem;

  root /var/www/nexdrive;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
  add_header X-Robots-Tag "noindex, nofollow" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.nexdrive.co.uk; frame-ancestors 'self' https://nexyraconsulting.co.uk; base-uri 'self'; form-action 'self'" always;

  # Public product page: indexable, no unsafe-eval, not frameable.
  # add_header inside a location replaces the server-level set, so the full list is repeated here.
  location ^~ /product/ {
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src 'self' https://app.nexdrive.co.uk; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ /product/index.html;
  }

  # Never serve backend-only files
  location ~ ^/(database|server|config|docs)/ { deny all; }
  location ~ \.(md|sql|example|yml|json)$ { deny all; }
  location = /manifest.webmanifest       { add_header Cache-Control "no-cache"; }
  location ~ /\.                  { deny all; }

  location ~* \.(woff2)$                 { expires 1y; add_header Cache-Control "public, immutable"; }
  location ^~ /js/vendor/                { expires 1y; add_header Cache-Control "public, immutable"; }
  location ~* \.(svg|png|css)$           { expires 7d; }
  location = /js/config.js               { add_header Cache-Control "no-cache"; }
  location ~* \.html$                    { add_header Cache-Control "no-cache"; }

  location / { try_files $uri $uri/ /index.html; }
}

server {
  listen 80;
  server_name app.nexdrive.co.uk;
  return 301 https://$host$request_uri;
}
